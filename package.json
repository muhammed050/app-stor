{
  "name": "eldevo-publish",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin": "node scripts/admin.mjs",
    "check": "node --check server/index.mjs && node --check server/domain.mjs && node --check server/db.mjs",
    "test:browser": "node tests/browser.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import-sqlite": "node scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pg": "8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  }
}
