# Server-only PostgreSQL URI from Supabase Dashboard > Connect > Session pooler.
# URL-encode special characters in the database password. Never use VITE_ for this value.
SUPABASE_DB_URL=
# Optional PEM CA certificate from Supabase database settings, when required.
# SUPABASE_DB_CA=
# Local PostgreSQL development only: DATABASE_SSL=disable

PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Set NODE_ENV=production behind HTTPS. Use a persistent disk for DATA_DIR.
# SESSION_DAYS=14
# Transactional email. EMAIL_FROM must belong to a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=Dorucenie <notifications@dorucenie.com>
# Alternative webhook: HTTPS POST JSON {to,subject,text,html}; must honor Idempotency-Key.
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=

# Whop: create checkout configurations and read/receive payments.
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
WHOP_WEBHOOK_SECRET=
# Register webhook: https://your-domain/api/webhooks/whop
# payment.succeeded, payment.refunded, payment.dispute.created (available event names depend on Whop API version).
# The server handles signed refund/dispute event families conservatively.
